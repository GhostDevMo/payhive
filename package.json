{
  "name": "payhive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@payhive/server",
    "dev:web": "npm run dev --workspace=@payhive/web",
    "db:migrate": "npm run db:migrate --workspace=@payhive/server",
    "db:reset": "npm run db:reset --workspace=@payhive/server",
    "test": "npm run test --workspace=@payhive/server",
    "typecheck": "npm run typecheck --workspace=@payhive/server && npm run typecheck --workspace=@payhive/web",
    "build": "npm run build --workspace=@payhive/server && npm run build --workspace=@payhive/web",
    "start": "npm run start --workspace=@payhive/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
