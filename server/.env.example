# Copy to .env and adjust.

DATABASE_URL=postgres://payhive:payhive@localhost:5432/payhive
PORT=4000
WEB_ORIGIN=http://localhost:5173

# mock   - deposits settle instantly, no keys needed. Use for development.
# stripe - real PaymentIntents; wallets are credited by webhook only.
PAYMENT_PROVIDER=mock

# Required when PAYMENT_PROVIDER=stripe. Use test keys until you have written
# approval from Stripe for PayHive's business category — see README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Guards /admin/reconciliation, which reports every account's position. Unset
# means the endpoint refuses every request, so a deployment that forgets this
# fails loudly instead of exposing the books. Generate a real one for anything
# public: openssl rand -hex 32
ADMIN_TOKEN=dev-only-not-a-secret
