# Copy to .env and adjust.

DATABASE_URL=postgres://payhive:payhive@localhost:5432/payhive
PORT=4000
WEB_ORIGIN=http://localhost:5173

# mock   - deposits settle instantly, no keys needed. Use for development.
# stripe - real PaymentIntents; wallets are credited by webhook only.
PAYMENT_PROVIDER=mock

# Required when PAYMENT_PROVIDER=stripe. Use test keys until you have written
# approval from Stripe for PayHive's business category — see README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Guards /admin/reconciliation, which reports every account's position. Unset
# means the endpoint refuses every request, so a deployment that forgets this
# fails loudly instead of exposing the books. Generate a real one for anything
# public: openssl rand -hex 32
ADMIN_TOKEN=dev-only-not-a-secret

# --- Bank linking -----------------------------------------------------------
# mock  - simulates the aggregator handshake, no account needed. Use for dev.
# plaid - real Plaid Link. The user signs in to their bank inside Plaid's UI,
#         so no bank credentials ever reach this server.
BANK_LINK_PROVIDER=mock

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Which payment provider Plaid should mint a payout token for, e.g. "stripe".
# Leave empty to link accounts for display without enabling payouts yet.
PLAID_PROCESSOR=

# Encrypts the aggregator access token before it is stored. Required as soon as
# anyone links a bank account. Generate with: openssl rand -hex 32
SECRETS_KEY=dev-only-secrets-key-change-me-please

# --- Email -------------------------------------------------------------------
# console - prints messages to the terminal. No account needed; use for dev.
# resend  - sends for real via https://resend.com
EMAIL_PROVIDER=console

RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. PayHive <no-reply@payhive.app>
EMAIL_FROM=

# Where emailed links point. Set this to the deployed front end, or every reset
# link will send people to localhost.
APP_URL=http://localhost:5173
